#!/bin/sh
set -eu

changes="$(git diff --cached --name-status -- \
  'public/examples/**' \
  'data/examples/**' \
  'test-fixtures/**' \
  'reports/**' \
  'docs/portfolio/private/**' \
  'docs/portfolio/assets/private/**' \
  'docs/perf/**' \
  'docs/qa/yshy_*' \
  'docs/qa/archive/**' \
  'docs/validation/verify/**' \
  'docs/validation/working/**' \
  'docs/validation/sheets/**' \
  ':!reports/README.md' \
  ':!reports/.gitkeep' || true)"

blocked=""
old_ifs="$IFS"
IFS='
'
for line in $changes; do
  status="${line%%	*}"
  if [ "$status" != "D" ]; then
    blocked="${blocked}${line}
"
  fi
done
IFS="$old_ifs"

if [ -n "$blocked" ]; then
  echo "Blocked commit: local-only Roll20 sheet fixtures/reports/assets are staged." >&2
  echo "$blocked" >&2
  echo "Keep real or derived sheets local. Commit scripts/docs only, or publish a sanitized artifact explicitly." >&2
  exit 1
fi

root="$(git rev-parse --show-toplevel)"
origin_url="$(git config --get remote.origin.url 2>/dev/null || true)"
case "$root" in
  *web-push-main) ;;
  *)
    # Clean-room clones/worktrees (docs/operations/39_two_host_agent_prompts.md)
    # are identified by the canonical origin instead of the folder name.
    case "$origin_url" in
      *[Ss]ong991123/roll20-block-editor*) ;;
      *)
        echo "Blocked commit: git root is not web-push-main and origin is not the canonical repo: $root ($origin_url)" >&2
        exit 1
        ;;
    esac
    ;;
esac

node "$root/scripts/roll20_renderer_model_guard.mjs" >/dev/null
